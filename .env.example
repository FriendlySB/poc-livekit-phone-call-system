# OpenAI Configuration 
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
OPENAI_WEBHOOK_SECRET=whsec_xxxx
OPENAI_PROJECT_ID=proj_xxxx

# Optional: Enable debug logging for OpenAI events
DEBUG_OPENAI=false

# ServeAI API
SERVE_AI_API_ENDPOINT=http://localhost:4000/api
SERVE_AI_CLIENT_ID="username"
SERVE_AI_CLIENT_SECRET="password"

# ServeAI AI Agent Chatflow ID (Optional - can be configured via API)
SERVE_AI_CHATFLOW_ID = "d327411f-7285-4e57-be2a-e4335f85d376"

# Host and Port Configuration
PORT=5000
HOST=nonedified-concomitantly-bette.ngrok-free.dev

# Twilio Configuration
TWILIO_ACCOUNT_SID=xxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_NUMBER=+60393880432

# The phone number for the human agent
HUMAN_AGENT_NUMBER=+60xxxxxxx

# ElevenLabs API Key
ELEVENLABS_API_KEY=sk_xxxxx

# ElevenLabs Agent ID
ELEVENLABS_AGENT_ID=agent_xxxxx

# ElevenLabs voice ID used by the LiveKit agent worker's TTS
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Voice-pipeline provider selection (LiveKit agent worker) is PER CALL: ServeAI's phoneCallConfig
# fields liveKitSTT / liveKitTTS choose each leg and arrive in the dispatch metadata. Keys match the
# connection blocks below — STT: elevenlabs | speaches | sherpa | sensevoice; TTS: elevenlabs |
# speaches | chatterbox | voxcpm | pocket | vibevoice. The two vars below are an OPTIONAL local override (used when the
# config omits them, e.g. testing without ServeAI); leave commented to rely on ServeAI. Setting
# STT_PROVIDER also warm-preloads the in-process sherpa/SenseVoice model in prewarm.
# STT_PROVIDER=elevenlabs            # elevenlabs | speaches | sherpa | sensevoice
# TTS_PROVIDER=elevenlabs            # elevenlabs | speaches | chatterbox | voxcpm | pocket | vibevoice

# Self-hosted Speaches (OpenAI-compatible) — used when *_PROVIDER=speaches.
# Container API listens on port 8000; baseURL must end in /v1.
SPEACHES_BASE_URL=http://localhost:8000/v1
SPEACHES_API_KEY=speaches          # dummy unless Speaches API_KEY auth is enabled
# large-v3-turbo: best English accuracy on 8kHz phone audio; runs on the GPU (incl.
# RTX 50-series/Blackwell) at float16 in ~0.7s. `Systran/faster-whisper-base` is much
# faster to download but too inaccurate for phone audio. After downloading, VERIFY it
# completed (~1.6GB, no *.incomplete files) — a truncated model.bin segfaults the server.
SPEACHES_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
SPEACHES_STT_LANGUAGE=en           # ISO code; openai.STT defaults to en if unset
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEACHES_TTS_VOICE=af_heart

# Self-hosted Chatterbox TTS (Resemble AI) — used when TTS_PROVIDER=chatterbox. Runs as a
# separate server (start it manually: see README). OpenAI-compatible /v1/audio/speech, but
# wav-only (no pcm), so the POC uses a custom client (src/chatterboxTts.mjs). baseURL ends in /v1.
CHATTERBOX_BASE_URL=http://localhost:8004/v1
CHATTERBOX_API_KEY=chatterbox      # dummy; Chatterbox has no auth
CHATTERBOX_TTS_MODEL=chatterbox-turbo   # required by the schema; the loaded model is fixed server-side
CHATTERBOX_TTS_VOICE=Emily.wav     # predefined-voice filename (must include the .wav extension)

# Self-hosted VoxCPM 1.5 TTS — used when TTS_PROVIDER=voxcpm. nano-vLLM-VoxCPM in Docker on :8001
# (see README). NOT OpenAI-shaped: a custom client (src/voxcpmTts.mjs) POSTs /generate in our
# raw-PCM fork mode (format:"pcm"), so BASE_URL has NO /v1 suffix and there's no API key (no auth).
VOXCPM_BASE_URL=http://localhost:8001
# Fixed reference-clone voice: JSON of { prompt_latents_base64, prompt_text } produced offline via
# the server's /encode_latents. IMPORTANT: VoxCPM is sensitive to reference quality — use a CLEAN
# clip with an EXACT transcript (the committed voice is a clean ElevenLabs render of a known script;
# a Chatterbox clip + whisper-guessed transcript caused ~17% runaway generations). Comment out to
# use VoxCPM's zero-shot voice (stable, but inconsistent across turns).
VOXCPM_VOICE_FILE=assets/voxcpm-voice.json
VOXCPM_CFG_VALUE=2                 # classifier-free guidance scale (higher = closer to the clone)
# Generation-step SAFETY CAP. VoxCPM sometimes fails to emit end-of-speech and runs away,
# generating to the cap (~0.16s audio/step). 200 bounds a runaway to ~32s audio / a few
# seconds wall (under LiveKit's ~10s stall watchdog) without truncating real sentences
# (which finish in 20-60 steps). Also keeps prompt(~113) + cap <= max_model_len(2048).
VOXCPM_MAX_GENERATE_LENGTH=200
VOXCPM_TEMPERATURE=1

# Self-hosted Pocket TTS (Kyutai) — used when TTS_PROVIDER=pocket. A 100M-param, CPU-ONLY model
# behind its community OpenAI-compatible server (teddybear082/pocket-tts-openai_streaming_server)
# on :49112 (see README). Because that server emits 24 kHz mono PCM, the POC reuses the stock
# openai.TTS path (exactly like Speaches) — no custom client. baseURL ends in /v1; no real auth.
# Running TTS on CPU frees the GPU for STT, sidestepping the 8GB VRAM contention that the GPU
# TTS options (Chatterbox/VoxCPM) hit. VOICE is a built-in Pocket voice name (alba, giovanni,
# lola, ...) or a cloned-voice filename dropped in the server's voices dir.
POCKET_BASE_URL=http://localhost:49112/v1
POCKET_API_KEY=pocket              # dummy; the server has no auth
POCKET_TTS_MODEL=pocket-tts        # ignored server-side; kept for the OpenAI schema
POCKET_TTS_VOICE=alba

# Self-hosted VibeVoice-Realtime-0.5B (Microsoft) — used when TTS_PROVIDER=vibevoice. A 0.5B GPU
# model (~2.5GB VRAM) fronted by our OWN thin OpenAI shim (VibeVoice/demo/openai_server.py) on
# :8020 — the upstream repo ships only a websocket demo, and the community Docker server needs
# CUDA 13 / driver >= 580. The shim serves the model's native 24 kHz mono PCM through
# /v1/audio/speech, so this reuses the stock openai.TTS path (like Speaches/Pocket); no custom
# client. baseURL ends in /v1; no auth. NOTE: this model has NO voice cloning — VOICE must be one
# of the fixed presets, and Microsoft licenses it for research/dev only (not commercial use).
VIBEVOICE_BASE_URL=http://localhost:8020/v1
VIBEVOICE_API_KEY=vibevoice         # dummy; the shim has no auth
VIBEVOICE_TTS_MODEL=vibevoice-realtime  # ignored server-side; kept for the OpenAI schema
# en-Carter_man | en-Davis_man | en-Emma_woman | en-Frank_man | en-Grace_woman | en-Mike_man
VIBEVOICE_TTS_VOICE=en-Emma_woman

# Self-hosted sherpa-onnx streaming STT — used when STT_PROVIDER=sherpa. Runs in-process
# (no server), CPU is plenty (RTF ~0.06). Download/extract a streaming model into models/
# (see README), then point these at the extracted files. Paths resolve from the project
# root. int8 files are the smaller/faster default.
#
# SHERPA_STT_MODEL_TYPE picks the model family (the recognizer config differs):
#   transducer (default) -> zipformer: encoder + decoder + JOINER. English-specialised.
#   paraformer           -> FunASR streaming paraformer: encoder + decoder, NO joiner.
#                           Bilingual zh-en (English is the minority of training data, so
#                           English phone-audio accuracy may be worse — A/B it before trusting it).
# When unset, the ENCODER/DECODER/(JOINER)/TOKENS defaults match each type's filenames, so
# switching models is just MODEL_TYPE + MODEL_DIR. Paraformer download: see README.
SHERPA_STT_MODEL_TYPE=transducer   # transducer | paraformer
SHERPA_STT_MODEL_DIR=./models/sherpa-onnx-streaming-zipformer-en-2023-06-21
SHERPA_STT_ENCODER=encoder-epoch-99-avg-1.int8.onnx
SHERPA_STT_DECODER=decoder-epoch-99-avg-1.onnx
SHERPA_STT_JOINER=joiner-epoch-99-avg-1.int8.onnx
SHERPA_STT_TOKENS=tokens.txt
SHERPA_STT_NUM_THREADS=2
SHERPA_STT_LANGUAGE=en
# Paraformer alternative (uncomment and set MODEL_TYPE=paraformer to A/B for quality):
# SHERPA_STT_MODEL_DIR=./models/sherpa-onnx-streaming-paraformer-bilingual-zh-en
# SHERPA_STT_ENCODER=encoder.int8.onnx
# SHERPA_STT_DECODER=decoder.int8.onnx
# Trailing silence (s) after speech before a FINAL fires. Lowering it splits turns on
# natural mid-sentence pauses; keep the library default 1.2s. (rule1/rule3 also override-able.)
SHERPA_STT_RULE2_SILENCE=1.2
# Speculative generation: once the transcript holds steady this many ms (caller paused), emit
# a PREFLIGHT so the LLM pre-generates during the endpoint wait — this is what makes the
# turnaround fast. Lower = earlier head start but more discarded speculative calls. 0 disables.
SHERPA_STT_PREFLIGHT_MS=300

# Self-hosted OFFLINE SenseVoice STT — used when STT_PROVIDER=sensevoice. Runs in-process
# (no server), CPU. Non-autoregressive single-pass → fast batch transcription; the A/B
# target vs Whisper. It's BATCH (no interim transcripts), so turn-taking uses the VAD path
# like Speaches (no PREFLIGHT). Download the model into models/ (see README), then point
# these at the files (paths from project root). The 2025-09-09 repo ships fp32 model.onnx only.
SENSEVOICE_MODEL_DIR=./models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2025-09-09
SENSEVOICE_MODEL=model.onnx
SENSEVOICE_TOKENS=tokens.txt
SENSEVOICE_LANGUAGE=en             # auto|zh|en|ja|ko|yue — pin to en so it never drifts
SENSEVOICE_NUM_THREADS=2
SENSEVOICE_USE_ITN=1               # inverse text normalization (e.g. "twenty" -> "20")

# LiveKit Configuration
# LIVEKIT_MODE selects how Twilio audio reaches LiveKit when provider=livekit:
#   cloud    -> use the managed Twilio Connector (connectTwilioCall). Cloud only.
#   selfhost -> use our own Twilio<->LiveKit WebSocket bridge against a self-hosted
#               livekit-server (the OSS server has no Connector service). See
#               src/services/livekitBridgeService.js.
LIVEKIT_MODE=cloud

# Cloud values:
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=API123456
LIVEKIT_API_SECRET=secret123456

# Self-hosted (livekit-server --dev) values — uncomment when LIVEKIT_MODE=selfhost.
# The backend AND the agent worker must share these so room tokens validate.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret